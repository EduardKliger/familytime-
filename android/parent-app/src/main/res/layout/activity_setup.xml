<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👨‍👩‍👧 FamilyTime"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#6C63FF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parent App"
        android:textSize="18sp"
        android:textColor="#888888"
        android:layout_marginBottom="40dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Home PC IP address"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_server_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="192.168.1.x"
        android:inputType="textUri"
        android:textSize="20sp"
        android:padding="14dp"
        android:background="@drawable/input_bg"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_go"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open FamilyTime"
        android:textSize="18sp"
        android:padding="16dp"
        android:backgroundTint="#6C63FF"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the IP of the PC running the FamilyTime server.\nYou only need to do this once."
        android:textSize="13sp"
        android:textColor="#AAAAAA"
        android:textAlignment="center"
        android:layout_marginTop="20dp" />

</LinearLayout>
