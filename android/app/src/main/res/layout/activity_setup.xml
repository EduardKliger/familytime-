<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏠 FamilyTime Setup"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Server IP (e.g. 192.168.1.100)"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_server_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="192.168.1.x"
        android:inputType="textUri"
        android:textSize="18sp"
        android:padding="14dp"
        android:background="@drawable/input_bg"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kid profile ID (e.g. profile_kid_amy)"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_kid_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="profile_kid_amy"
        android:inputType="text"
        android:textSize="18sp"
        android:padding="14dp"
        android:background="@drawable/input_bg"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activate FamilyTime"
        android:textSize="18sp"
        android:padding="16dp"
        android:backgroundTint="#6C63FF"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Profile IDs: profile_kid_amy | profile_kid_guy | profile_kid_mia"
        android:textSize="12sp"
        android:textColor="#888888"
        android:textAlignment="center"
        android:layout_marginTop="16dp" />

</LinearLayout>
